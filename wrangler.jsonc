{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vulpi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_PUBLIC_BUCKET",
      "bucket_name": "vulpi-public-vehicles"
    },
    {
      "binding": "R2_PRIVATE_BUCKET",
      "bucket_name": "vulpi-private-kyc"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}
